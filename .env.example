# ===== 大模型（二选一或都配，Demo 至少配一个）=====
# 火山方舟（豆包）OpenAI 兼容接口
VOLC_ARK_API_KEY=your_volc_ark_api_key_here
VOLC_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLC_ARK_MODEL=ep-your-endpoint-id

# MiniMax H3（OpenAI 兼容示例，按官方文档调整 base_url）
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# Demo 默认使用哪个 provider：volc | minimax
LLM_PROVIDER=volc

# ===== Demo 服务 =====
DEMO_HOST=0.0.0.0
DEMO_PORT=8765

# 默认城市（无 GPS 时）
DEFAULT_CITY=衢州
